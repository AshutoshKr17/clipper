# Highlight detection LLM: "gradient" (DigitalOcean), "openai" or "anthropic".
LLM_PROVIDER=gradient
GRADIENT_API_KEY= # or AI_KEY=
# Run `python -m clipper models` to see what your key can use.
# Cheaper alternatives: deepseek-v4.1-flash, openai-gpt-5.6-luna
LLM_MODEL=anthropic-claude-sonnet-5.5

# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# ANTHROPIC_API_KEY=

# faster-whisper model: tiny, base, small, medium, large-v3 (bigger = more accurate, slower)
WHISPER_MODEL=small

# YouTube (OAuth "Desktop app" client from Google Cloud Console)
YOUTUBE_CLIENT_SECRET=client_secret.json
YOUTUBE_TOKEN=token.json

# Instagram Reels (Business/Creator account linked to a Facebook Page)
IG_USER_ID=
IG_ACCESS_TOKEN=
